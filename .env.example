# Copy to `.env`. docker-compose reads these too.
# ---- Database ----
POSTGRES_USER=ride
POSTGRES_PASSWORD=ridepass
POSTGRES_DB=ridematch
# For running the API OUTSIDE docker (local `npm run dev`), point at localhost:
DATABASE_URL=postgresql://ride:ridepass@localhost:5432/ridematch

# ---- Auth ----
# Use a long random string in anything real:  openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-please-32-chars-min
JWT_EXPIRES_IN=1d

# ---- App ----
NODE_ENV=development
PORT=3000
# Default proximity radius for matching, in metres (5 km).
MATCH_RADIUS_METERS=5000
